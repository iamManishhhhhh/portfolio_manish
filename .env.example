# Environment variables — copy this file to .env.local for local development.
# NEVER commit .env.local or any file containing actual secrets.

# Resend Email Service Configuration
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>
RESEND_TO_EMAIL=your_email@example.com

# Optional Email Validation API (https://app.abstractapi.com/api/email-validation/tester)
ABSTRACT_API_KEY=your_abstract_api_key_here

# Distributed Upstash Redis Rate Limiting (Optional)
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

